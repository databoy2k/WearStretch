<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector android:width="120dp" android:height="120dp"
            android:viewportWidth="100" android:viewportHeight="100">
            <path android:strokeColor="#5E8AC7" android:strokeWidth="7" android:strokeLineCap="round" android:pathData="M38,44 L48,64" />
            <path android:strokeColor="#5E8AC7" android:strokeWidth="7" android:strokeLineCap="round" android:pathData="M62,44 L52,64" />
            <path android:name="muscle0" android:strokeColor="#00E676" android:strokeWidth="4" android:strokeAlpha="0.85" android:strokeLineCap="round" android:pathData="M40,46 L49,63" />
            <path android:name="muscle1" android:strokeColor="#00E676" android:strokeWidth="4" android:strokeAlpha="0.85" android:strokeLineCap="round" android:pathData="M60,46 L51,63" />
            <group android:name="hands" android:pivotX="50" android:pivotY="52">
                <path android:strokeColor="#5E8AC7" android:strokeWidth="5" android:strokeLineCap="round" android:pathData="M48,64 L50,70" />
                <path android:strokeColor="#5E8AC7" android:strokeWidth="5" android:strokeLineCap="round" android:pathData="M52,64 L50,70" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="hands">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="rotation" android:duration="2600"
                android:valueFrom="6" android:valueTo="-4" android:repeatCount="infinite" android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="muscle0">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:duration="900"
                android:valueFrom="0.3" android:valueTo="1.0" android:repeatCount="infinite" android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
    <target android:name="muscle1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:duration="900"
                android:valueFrom="0.3" android:valueTo="1.0" android:repeatCount="infinite" android:repeatMode="reverse"
                android:interpolator="@android:interpolator/accelerate_decelerate" />
        </aapt:attr>
    </target>
</animated-vector>
